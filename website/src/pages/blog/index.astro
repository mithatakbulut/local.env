---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog — local.env" description="Release notes, security advisories, and product updates for local.env.">
  <p class="eyebrow">Blog</p>
  <h1>Product updates</h1>
  {posts.length === 0 ? <p class="lede">Published updates will appear here.</p> : <div class="card-grid">{posts.map((post) => <article class="card"><p>{post.data.category}</p><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p></article>)}</div>}
</BaseLayout>
