    "verify": "npm run check && npm run build && npm run test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.123.0"
  }
}
