{
  "name": "localenv-public-website",
  "private": true,
  "version": "0.1.0",
  "description": "Static public website and documentation for local.env.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/harden-output.mjs",
